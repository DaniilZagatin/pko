# Скопируйте в .env (или экспортируйте вручную перед `pko serve`/`pko progress`).
# .env сам по себе не подхватывается — это просто справочный список того, что
# нужно задать в окружении; способ загрузки (export, systemd EnvironmentFile,
# ваш обычный процесс-менеджер) выбираете сами.

# Обязательно хотя бы это — общий дефолт для обеих ролей (matcher и reporter).
# Эндпоинт должен быть OpenAI-совместимым (/chat/completions).
PKO_ASSEMBLER_BASE_URL=https://<внутренний-glm-endpoint>/v1
PKO_ASSEMBLER_MODEL=GLM-5.2
PKO_ASSEMBLER_API_KEY=

# Необязательно: отдельные модель/ключ под единого агента matcher (слайды +
# код -> пункты плана и вердикты за одну сессию), если он должен отличаться
# от общего дефолта выше.
# PKO_MATCHER_BASE_URL=
# PKO_MATCHER_MODEL=
# PKO_MATCHER_API_KEY=

# Необязательно: отдельные модель/ключ под роль reporter (вердикты по всем
# пунктам -> связный текстовый вывод). Без них reporter резолвится через общий
# дефолт выше; если не задан и он, сводного вывода просто не будет в отчёте.
# PKO_REPORTER_BASE_URL=
# PKO_REPORTER_MODEL=
# PKO_REPORTER_API_KEY=
